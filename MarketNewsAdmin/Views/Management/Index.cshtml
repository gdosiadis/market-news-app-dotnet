@model MarketNewsAdmin.Models.ManagementListViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="page-actions"><div><span class="eyebrow">CONFIGURATION LIBRARY</span><p>Search, review and safely update production configuration.</p></div><div class="page-action-buttons">@if (Model.Section is "sources" or "greek-sources") { <form method="post" asp-action="SetSourcesSelected"><input type="hidden" name="section" value="@Model.Section"/><input type="hidden" name="selected" value="true"/><button class="button secondary" type="submit"><i data-lucide="check-check"></i>Select all</button></form><form method="post" asp-action="SetSourcesSelected"><input type="hidden" name="section" value="@Model.Section"/><input type="hidden" name="selected" value="false"/><button class="button secondary" type="submit"><i data-lucide="ban"></i>Deselect all</button></form> }@if (Model.CanCreate) { <a class="button primary" asp-action="Edit" asp-route-section="@Model.Section"><i data-lucide="plus"></i>Add @Model.Title.TrimEnd('s')</a> }</div></div>
<section class="panel"><form class="searchbar" method="get"><input type="hidden" name="section" value="@Model.Section"/><i data-lucide="search"></i><input name="search" value="@Model.Search" placeholder="Search @Model.Title.ToLowerInvariant()"/><button type="submit">Search</button></form><div class="table-wrap"><table><thead><tr><th>Configuration item</th><th>Source URL</th><th>Status</th><th class="align-right">Actions</th></tr></thead><tbody>@if (!Model.Rows.Any()) { <tr><td colspan="4" class="empty-cell">No matching configuration found.</td></tr> } @foreach (var row in Model.Rows) { <tr><td><strong>@row.Primary</strong></td><td class="truncate" title="@row.Secondary">@if (Model.Section is "sources" or "greek-sources") { <form class="inline-form source-selection" method="post" asp-action="ToggleSource"><input type="hidden" name="section" value="@Model.Section"/><input type="hidden" name="id" value="@row.Id"/><input type="checkbox" checked="@(row.Enabled == true)" onchange="this.form.submit()" aria-label="@(row.Enabled == true ? $"Exclude {row.Primary} from scraping" : $"Select {row.Primary} for scraping")"/></form> }<span>@row.Secondary</span></td><td>@if (row.Enabled is bool enabled) { <span class="status @(enabled ? "enabled" : "disabled")">@(enabled ? "Selected" : "Excluded")</span> } else { <span class="status neutral">Managed</span> }</td><td class="align-right"><a class="icon-button" title="Edit" asp-action="Edit" asp-route-section="@Model.Section" asp-route-id="@row.Id"><i data-lucide="pencil"></i></a>@if (Model.CanCreate) { <form class="inline-form" method="post" asp-action="Delete" data-confirm="Delete this configuration entry? This cannot be undone."><input type="hidden" name="section" value="@Model.Section"/><input type="hidden" name="id" value="@row.Id"/><button class="icon-button danger" title="Delete" type="submit"><i data-lucide="trash-2"></i></button></form> }</td></tr> }</tbody></table></div></section>
