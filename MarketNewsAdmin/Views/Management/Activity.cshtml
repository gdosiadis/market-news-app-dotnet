@model MarketNewsAdmin.Models.ActivityViewModel
@{ ViewData["Title"] = "Change history"; }
<section class="panel"><div class="panel-head"><div><span class="eyebrow">AUDIT LOG</span><h2>Configuration activity</h2></div><span class="muted">Most recent 200 events</span></div><div class="table-wrap"><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Record</th><th>Change detail</th></tr></thead><tbody>@foreach (var entry in Model.Entries) { <tr><td>@entry.OccurredAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</td><td>@entry.Actor</td><td><span class="status neutral">@entry.Action</span></td><td><strong>@entry.EntityType</strong> #@entry.EntityId</td><td class="truncate">@(entry.AfterJson ?? entry.BeforeJson ?? "No snapshot")</td></tr> }</tbody></table></div></section>