@model MarketNewsAdmin.Models.DashboardViewModel
@{ ViewData["Title"] = "Overview"; }
<div class="hero-strip"><div><span class="eyebrow">MARKET OPERATIONS</span><h2>Today’s briefing, governed.</h2><p>Your sources, AI instructions and distribution settings in one controlled workspace.</p></div><div class="hero-actions"><form asp-action="RunNow" method="post" data-confirm="Start the full scrape, summary, and email delivery now?"><button class="button primary" type="submit"><i data-lucide="send"></i>Scrape &amp; send report</button></form><a class="button gold" asp-controller="Management" asp-action="Index" asp-route-section="sources"><i data-lucide="sliders-horizontal"></i>Manage sources</a></div></div>
<div class="metrics-grid"><article class="metric"><span>ACTIVE SOURCES</span><strong>@Model.EnabledSources<small>/ @Model.TotalSources</small></strong><i data-lucide="radio-tower"></i></article><article class="metric"><span>FEATURE FLAGS</span><strong>@Model.ActiveFlags</strong><i data-lucide="toggle-right"></i></article><article class="metric"><span>EMAIL RECIPIENTS</span><strong>@Model.EnabledRecipients</strong><i data-lucide="mail-check"></i></article><article class="metric"><span>NEXT DAILY RUN</span><strong>@Model.NextSchedule</strong><i data-lucide="clock-3"></i></article></div>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">AUDIT TRAIL</span><h2>Recent activity</h2></div><a asp-controller="Management" asp-action="Activity">View all <i data-lucide="arrow-up-right"></i></a></div><div class="activity-list">@if (!Model.RecentActivity.Any()) { <p class="muted">No configuration changes recorded yet.</p> } @foreach (var item in Model.RecentActivity) { <div class="activity"><span class="activity-icon"><i data-lucide="pen-line"></i></span><div><strong>@item.Action @item.EntityType</strong><p>@item.Actor changed record @item.EntityId</p></div><time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.LocalDateTime.ToString("dd MMM, HH:mm")</time></div> }</div></section>