@model MarketNewsAdmin.Controllers.LoginViewModel
@{ Layout = null; ViewData["Title"] = "Sign in"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Sign in | Market Summarizer</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&display=swap"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><script src="https://unpkg.com/lucide@latest"></script></head>
<body class="login-body"><main class="login-panel"><div class="login-brand"><span class="brand-word">Optima</span><span class="brand-sub">bank</span><small>MARKET SUMMARIZER</small></div><div class="login-intro"><span class="eyebrow">SECURE ACCESS</span><h1>Configuration, with conviction.</h1><p>Manage the intelligence behind your daily market briefings.</p></div><form method="post" class="login-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="ReturnUrl" type="hidden"/><label>Username<input asp-for="Username" autocomplete="username" autofocus /></label><label>Password<input asp-for="Password" autocomplete="current-password" /></label><button class="button primary wide" type="submit">Sign in <i data-lucide="arrow-right"></i></button></form></main><script>lucide.createIcons();</script></body></html>