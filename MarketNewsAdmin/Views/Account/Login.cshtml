@model MarketNewsAdmin.Controllers.LoginViewModel
@{ Layout = null; ViewData["Title"] = "Sign in"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Sign in | Market Summarizer</title><link rel="icon" type="image/svg+xml" href="~/images/optima-o.svg" asp-append-version="true"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><script src="https://unpkg.com/lucide@latest"></script><script>(() => { const favicon = document.querySelector('link[rel="icon"]'); const optimaIcon = favicon.href; const frames = ["&#9698;", "&#9699;", "&#9700;", "&#9697;"]; let frame = 0; const loadingIcon = () => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="12" fill="#2b0033"/><text x="32" y="45" fill="#ff7a00" font-family="Arial" font-size="40" text-anchor="middle">${frames[frame++ % frames.length]}</text></svg>`)}`; const timer = window.setInterval(() => favicon.href = loadingIcon(), 120); window.addEventListener('load', () => { window.clearInterval(timer); favicon.href = optimaIcon; }, { once: true }); })();</script></head>
<body class="login-body"><main class="login-panel"><div class="login-brand"><img class="login-brand-logo" src="~/images/logo.png" alt="Optima bank" /><small>MARKET SUMMARIZER</small></div><div class="login-intro"><span class="eyebrow">SECURE ACCESS</span><h1>Configuration, with conviction.</h1><p>Manage the intelligence behind your daily market briefings.</p></div><form method="post" class="login-form"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="ReturnUrl" type="hidden"/><label>Username<input asp-for="Username" autocomplete="username" autofocus /></label><label>Password<input asp-for="Password" autocomplete="current-password" /></label><button class="button primary wide" type="submit">Sign in <i data-lucide="arrow-right"></i></button></form></main><script>lucide.createIcons();</script></body></html>