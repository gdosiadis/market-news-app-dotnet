# ── SQLite configuration ──────────────────────────────
# Non-secret production settings (sources, prompts, recipients, schedule,
# agent choice, report options and feature flags) are stored in this local file.
# The default is Data Source=market-news.db in the application's working directory.
SQLITE_CONNECTION_STRING=Data Source=market-news.db

# ── AI provider secrets ───────────────────────────────
# The AI provider and model are stored in SQLite. Keep credentials in a
# secret store/environment variable; never store API keys in the database.
GROQ_API_KEY=your_groq_api_key_here

# ── OpenAI-compatible proxy (production optional) ────
# Leave AI_PROVIDER=copilot for local GitHub Copilot SDK testing. For deployment,
# set AI_PROVIDER=openai and point OPENAI_ENDPOINT at a proxy implementing
# POST /chat/completions. The proxy may require its own API key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENDPOINT=

# ── Azure OpenAI / Azure AI Foundry secrets ───────────
AZURE_OPENAI_API_KEY=

# ── Gmail SMTP ────────────────────────────────────────
# Use an App Password (not your main Gmail password)
# Enable: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── SMTP override (optional) ─────────────────────────
# Set these to use a different SMTP server instead of Gmail,
# e.g. Mailpit for local testing: https://mailpit.axllent.org/
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURE=none
#   EMAIL_FROM=market-news@localhost
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

