# ── AI Provider ───────────────────────────────────────
# Selects which backend AiSummarizer uses. Leave unset (or "copilot") to
# default to the GitHub Copilot SDK — uses your logged-in Copilot session,
# no API key needed, and is reachable even behind firewalls that block
# api.groq.com / OpenAI endpoints.
#   copilot (default) → GitHub Copilot SDK (requires `copilot` CLI login)
#   groq              → Groq AI (needs GROQ_API_KEY below)
#   azure             → Azure OpenAI / Foundry (needs AZURE_OPENAI_* below)
# If AI_PROVIDER is unset, Azure OpenAI settings (if fully populated) take
# precedence over Copilot; explicit "copilot"/"groq" always wins.
AI_PROVIDER=copilot
# Optional: override the model used by the Copilot SDK provider
COPILOT_MODEL=

# ── Groq AI ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Azure OpenAI / Azure AI Foundry (optional) ───────
# If these are set (and AI_PROVIDER is not "copilot"/"groq"), the app uses
# Azure OpenAI instead of Copilot/Groq.
# Example endpoint: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name you created in Azure OpenAI / Foundry
AZURE_OPENAI_DEPLOYMENT=
# Optional (default in app: 2024-10-21)
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Gmail SMTP ────────────────────────────────────────
# Use an App Password (not your main Gmail password)
# Enable: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── SMTP override (optional) ─────────────────────────
# Set these to use a different SMTP server instead of Gmail,
# e.g. Mailpit for local testing: https://mailpit.axllent.org/
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURE=none
#   EMAIL_FROM=market-news@localhost
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

# ── Email Recipients (comma-separated) ───────────────
EMAIL_TO=recipient1@example.com,recipient2@example.com

# ── Schedule ──────────────────────────────────────────
# Time to send the daily report (24h format, server local time)
SEND_TIME=07:00
